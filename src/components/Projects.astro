---
---

<section id="projects" class="projects">
  <div class="projects-inner">
    <div class="section-label reveal">
      <span class="label-line"></span>
      <span>Projects</span>
    </div>
    <h2 class="projects-title reveal">
      Selected <span class="gradient-text">work</span>
    </h2>

    <div class="project-card reveal reveal-delay-1">
      <div class="project-info">
        <div class="project-number">01</div>
        <h3 class="project-name">2REAL4U</h3>
        <p class="project-description">
          A real estate platform built from scratch — featuring property listings, a custom CMS for publishing listings, and an elegant brand experience.
        </p>
        <div class="project-tags">
          <span class="tag">Web</span>
          <span class="tag">Full-Stack</span>
          <span class="tag">CMS</span>
          <span class="tag">Real Estate</span>
        </div>
        <a href="https://2real4u.at" target="_blank" rel="noopener noreferrer" class="project-link">
          Visit site
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7" /><path d="M7 7h10v10" />
          </svg>
        </a>
      </div>
      <div class="project-visual">
        <a href="https://2real4u.at" target="_blank" rel="noopener noreferrer" class="project-preview">
          <div class="preview-dots">
            <span></span><span></span><span></span>
          </div>
          <div class="preview-content">
            <span class="preview-url">2real4u.at</span>
            <img src="/2real4u-preview.png" alt="2REAL4U website screenshot" class="preview-screenshot" width="1280" height="800" loading="lazy" />
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .projects {
    padding: 8rem 2rem;
    position: relative;
  }

  .projects-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  .label-line {
    width: 40px;
    height: 1px;
    background: var(--accent);
  }

  .projects-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 3rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--accent) 0%, var(--cyan) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .project-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    padding: 2.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
    align-items: center;
  }
  .project-card:hover {
    border-color: var(--border-hover);
    box-shadow: 0 16px 64px rgba(0, 0, 0, 0.3), 0 0 0 1px var(--border-hover);
  }

  .project-number {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .project-name {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .project-description {
    font-size: 1rem;
    color: var(--foreground-muted);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .project-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .tag {
    padding: 0.3rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--foreground-muted);
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent);
    cursor: pointer;
    transition: gap 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }
  .project-link:hover {
    gap: 0.75rem;
    color: var(--accent-bright);
  }

  .project-visual {
    display: flex;
    justify-content: center;
  }

  .project-preview {
    width: 100%;
    max-width: 420px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .preview-dots {
    display: flex;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
  }
  .preview-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .preview-content {
    padding: 0.75rem 0.75rem 0.75rem;
  }

  .preview-url {
    display: block;
    font-size: 0.75rem;
    color: var(--foreground-muted);
    margin-bottom: 0.5rem;
    font-family: 'Space Grotesk', monospace;
    padding: 0 0.25rem;
  }

  .preview-screenshot {
    width: 100%;
    height: auto;
    border-radius: 6px;
    display: block;
    transition: transform 0.4s var(--ease-out);
  }
  .project-preview:hover .preview-screenshot {
    transform: scale(1.02);
  }

  @media (max-width: 768px) {
    .projects {
      padding: 5rem 1.25rem;
    }
    .project-card {
      grid-template-columns: 1fr;
      padding: 1.5rem;
    }
    .project-visual {
      order: -1;
    }
  }
</style>

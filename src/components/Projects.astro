---
const projects = [
  {
    number: "01",
    name: "2REAL4U",
    description:
      "A real estate platform built from scratch — featuring property listings, a custom CMS for publishing listings, and an elegant brand experience.",
    tags: ["Web", "Full-Stack", "CMS", "Real Estate"],
    previewUrl: "2real4u.at",
    previewImage: "/2real4u-preview.png",
    previewAlt: "2REAL4U website screenshot",
    links: [{ label: "Visit site", href: "https://2real4u.at" }],
  },
  {
    number: "02",
    name: "Lamark",
    description:
      "A full-stack local marketplace for buying and selling items, vehicles, real estate, and jobs — available on web and mobile.",
    tags: ["Web", "Mobile App", "Full-Stack", "Marketplace"],
    previewUrl: "lamark.rs",
    previewImage: "/lamark-preview.png",
    previewAlt: "Lamark marketplace homepage screenshot",
    links: [
      { label: "Visit site", href: "https://lamark.rs" },
      {
        label: "Google Play",
        href: "https://play.google.com/store/apps/details?id=com.lamark.app",
      },
      {
        label: "App Store",
        href: "https://apps.apple.com/at/app/lamark-srbija/id6759652245",
      },
    ],
  },
];
---

<section id="projects" class="projects">
  <div class="projects-inner">
    <div class="section-label reveal">
      <span class="label-line"></span>
      <span>Projects</span>
    </div>
    <h2 class="projects-title reveal">
      Selected <span class="gradient-text">work</span>
    </h2>

    {
      projects.map((project, index) => (
        <div class={`project-card reveal reveal-delay-${index + 1}`}>
          <div class="project-info">
            <div class="project-number">{project.number}</div>
            <h3 class="project-name">{project.name}</h3>
            <p class="project-description">{project.description}</p>
            <div class="project-tags">
              {project.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            <div class="project-links" aria-label={`${project.name} links`}>
              {project.links.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-link"
                >
                  {link.label}
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17L17 7" /><path d="M7 7h10v10" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
          <div class="project-visual">
            <a
              href={project.links[0].href}
              target="_blank"
              rel="noopener noreferrer"
              class="project-preview"
              aria-label={`Visit ${project.name}`}
            >
              <div class="preview-dots">
                <span></span><span></span><span></span>
              </div>
              <div class="preview-content">
                <span class="preview-url">{project.previewUrl}</span>
                <img
                  src={project.previewImage}
                  alt={project.previewAlt}
                  class="preview-screenshot"
                  width="1280"
                  height="800"
                  loading="lazy"
                />
              </div>
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .projects {
    padding: 8rem 2rem;
    position: relative;
  }

  .projects-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  .label-line {
    width: 40px;
    height: 1px;
    background: var(--accent);
  }

  .projects-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 3rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--accent) 0%, var(--cyan) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .project-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    padding: 2.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
    align-items: center;
  }

  .project-card + .project-card {
    margin-top: 2rem;
  }

  .project-card:hover {
    border-color: var(--border-hover);
    box-shadow: 0 16px 64px rgba(0, 0, 0, 0.3), 0 0 0 1px var(--border-hover);
  }

  .project-number {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .project-name {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .project-description {
    font-size: 1rem;
    color: var(--foreground-muted);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .project-tags,
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-tags {
    margin-bottom: 1.5rem;
  }

  .tag {
    padding: 0.3rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--foreground-muted);
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent);
    cursor: pointer;
    transition: gap 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }

  .project-link:hover {
    gap: 0.75rem;
    color: var(--accent-bright);
  }

  .project-visual {
    display: flex;
    justify-content: center;
  }

  .project-preview {
    width: 100%;
    max-width: 420px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .preview-dots {
    display: flex;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
  }

  .preview-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .preview-content {
    padding: 0.75rem;
  }

  .preview-url {
    display: block;
    font-size: 0.75rem;
    color: var(--foreground-muted);
    margin-bottom: 0.5rem;
    font-family: 'Space Grotesk', monospace;
    padding: 0 0.25rem;
  }

  .preview-screenshot {
    width: 100%;
    height: auto;
    border-radius: 6px;
    display: block;
    transition: transform 0.4s var(--ease-out);
  }

  .project-preview:hover .preview-screenshot {
    transform: scale(1.02);
  }

  @media (max-width: 768px) {
    .projects {
      padding: 5rem 1.25rem;
    }

    .project-card {
      grid-template-columns: 1fr;
      padding: 1.5rem;
    }

    .project-visual {
      order: -1;
    }
  }
</style>

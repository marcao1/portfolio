---
---

<section id="contact" class="contact">
  <div class="contact-inner">
    <div class="section-label reveal">
      <span class="label-line"></span>
      <span>Contact</span>
    </div>
    <h2 class="contact-title reveal">
      Let's build something<br /><span class="gradient-text">together</span>
    </h2>
    <p class="contact-description reveal reveal-delay-1">
      Got a project in mind or just want to say hi? I'm always open to new opportunities and interesting conversations.
    </p>
    <div class="contact-actions reveal reveal-delay-2">
      <a href="mailto:poechlmarco@gmail.com" class="contact-card">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
        <div>
          <span class="contact-card-label">Email</span>
          <span class="contact-card-value">poechlmarco@gmail.com</span>
        </div>
        <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17L17 7"/><path d="M7 7h10v10"/>
        </svg>
      </a>
      <a href="https://www.linkedin.com/in/marco-poechl/" target="_blank" rel="noopener noreferrer" class="contact-card">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>
        </svg>
        <div>
          <span class="contact-card-label">LinkedIn</span>
          <span class="contact-card-value">Marco Poechl</span>
        </div>
        <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17L17 7"/><path d="M7 7h10v10"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 8rem 2rem 6rem;
    position: relative;
  }

  .contact-inner {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
  }

  .section-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  .label-line {
    width: 40px;
    height: 1px;
    background: var(--accent);
  }

  .contact-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--accent) 0%, var(--cyan) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .contact-description {
    font-size: 1.05rem;
    color: var(--foreground-muted);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 360px;
    margin: 0 auto;
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    transition: border-color 0.3s var(--ease-out), transform 0.3s var(--ease-out), background 0.3s var(--ease-out);
    text-align: left;
    color: var(--foreground-muted);
  }
  .contact-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    background: var(--bg-elevated);
  }
  .contact-card:hover .arrow {
    transform: translate(2px, -2px);
    color: var(--accent);
  }

  .contact-card div {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .contact-card-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--foreground-muted);
  }

  .contact-card-value {
    font-weight: 600;
    color: var(--foreground);
    font-size: 0.95rem;
  }

  .arrow {
    transition: transform 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }

  @media (max-width: 640px) {
    .contact {
      padding: 5rem 1.25rem 4rem;
    }
  }
</style>
